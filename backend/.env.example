# Copy to `.env.local` (gitignored) for real values. Flow: ../README.md#setup

# --- Required for API + Prisma + import on the host (use 127.0.0.1 when MySQL is from compose) ---
DATABASE_URL=mysql://app:app@127.0.0.1:3306/real_estate

# --- Optional secrets / tuning (defaults exist in code; omit what you do not need) ---
# GEMINI_API_KEY=                        # tag:otodom:gemini + real POST /api/listings/ai-search (else mock)

# HTTP (npm run dev / local node)
# PORT=3000
# LISTEN_HOST=0.0.0.0

# Import paths (defaults: data/processed/otodom-listings.sanitized.json + tagged.json if present)
# OTODOM_SANITIZED_PATH=
# OTODOM_TAGGING_OUT=                    # also: OTODOM_TAGGED_PATH, OTODOM_TAGGED_JSON_PATH

# AI search + tagging models / prompts
# AI_SEARCH_GEMINI_MODEL=gemini-2.5-flash
# OTODOM_GEMINI_MODEL=gemini-2.5-flash
# AI_SEARCH_PROMPT_PATH=src/infrastructure/ai/prompts/listing-ai-search.prompt.md
# AI_SEARCH_MAX_CONVERSATION_CHARS=8000
# OTODOM_TAGGING_PROMPT_PATH=src/infrastructure/ai/prompts/listing-tagging.prompt.md
# OTODOM_TAGGING_LIMIT=                   # cap tagger rows (unset = all)
# OTODOM_TAGGING_DELAY_MS=400

# Crawl (npm run crawl:otodom) — see scripts/README-otodom-crawl.md
# OTODOM_LISTING_COUNT=100
# OTODOM_DETAIL_DELAY_MS=450
# OTODOM_LD_JSON_RAW_MAX=900000
# OTODOM_MAIN_TEXT_RAW_MAX=500000
# OTODOM_LOG=verbose

# Sanitize (npm run sanitize:otodom)
# OTODOM_SNAPSHOT_PATH=data/raw/otodom-listings.snapshot.json
# OTODOM_SANITIZED_OUT=data/processed/otodom-listings.sanitized.json
# OTODOM_SANITIZE_LIMIT=

# Preview tagging inputs — no Gemini (npm run preview:otodom:tagging-inputs)
# OTODOM_SANITIZED_PATH=data/test-data.sanitized.json
# OTODOM_TAGGING_PREVIEW_OUT=data/test-data.tagging-inputs.preview.json
# OTODOM_TAGGING_PREVIEW_LIMIT=

# Prisma without compose: npm run db:migrate / db:migrate:dev
