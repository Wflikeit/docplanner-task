# =============================================================================
# Intended flow (repo root has docker-compose.yaml)
# =============================================================================
#
# Runtime API: MySQL only (DATABASE_URL required). JSON under data/ are pipeline artifacts
# for import scripts — not the listing source over HTTP. See backend/README.md
# =============================================================================
# 1) Database + schema (MySQL + prisma migrate)
#    cd backend && npm run db:up
#    (or from repo root: docker compose up -d)
#
# 2) Data into DB: merge sanitized `items[]` + tagged `gemini` (by `externalId`). You need the **sanitized**
#    file (default data/processed/otodom-listings.sanitized.json). Tagged alone is not enough — but if you
#    omit OTODOM_SANITIZED_PATH and the default sanitized file is missing, import will try the path from **meta.inputPath**
#    in the tagged file (written when you ran `tag:otodom:gemini`).
#    cd backend && npm run db:import
#    Requires: DATABASE_URL
#
# 3) Backend: npm run dev (requires DATABASE_URL — reads only from MySQL)
# =============================================================================

DATABASE_URL=mysql://app:app@127.0.0.1:3306/real_estate

# Import / tag: defaults to data/processed/otodom-listings.sanitized.json
# and data/processed/otodom-listings.tagged.json if that file exists
OTODOM_SANITIZED_PATH=data/processed/otodom-listings.sanitized.json
OTODOM_TAGGING_OUT=data/processed/otodom-listings.tagged.json

# Tagging (`npm run tag:otodom:gemini`) and **AI listing search** (`POST /api/listings/ai-search` when the UI conversational search is enabled)
# For `docker compose`, put secrets in repo-root or `backend/` `.env`, `.env.local`, or `backend/.env.local` (see docker-compose `env_file`).
# GEMINI_API_KEY=
# AI_SEARCH_MOCK=1
# AI_SEARCH_GEMINI_MODEL=gemini-2.5-flash
# AI_SEARCH_PROMPT_PATH=src/infrastructure/ai/prompts/listing-ai-search.prompt.md
# AI_SEARCH_MAX_CONVERSATION_CHARS=8000
# OTODOM_GEMINI_MODEL=gemini-2.5-flash
# OTODOM_TAGGING_DELAY_MS=400
# OTODOM_TAGGING_PROMPT_PATH=src/infrastructure/ai/prompts/listing-tagging.prompt.md

# =============================================================================
# Crawl → sanitize
# =============================================================================
# npm run crawl:otodom
# OTODOM_LISTING_COUNT=100
# OTODOM_DETAIL_DELAY_MS=450

# npm run sanitize:otodom
# OTODOM_SNAPSHOT_PATH=data/raw/otodom-listings.snapshot.json
# OTODOM_SANITIZED_OUT=data/processed/otodom-listings.sanitized.json
# OTODOM_SANITIZE_LIMIT=100

# =============================================================================
# Preview tagging inputs (no Gemini)
# =============================================================================
# npm run preview:otodom:tagging-inputs
# OTODOM_SANITIZED_PATH=data/test-data.sanitized.json
# OTODOM_TAGGING_PREVIEW_OUT=data/test-data.tagging-inputs.preview.json
# OTODOM_TAGGING_PREVIEW_LIMIT=10

# =============================================================================
# Prisma migrations (when not using docker compose prisma-migrate)
# =============================================================================
# npm run db:migrate
# npm run db:migrate:dev
