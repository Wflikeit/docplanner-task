# Frontend exposes only two VITE_* vars (see src/vite-env.d.ts).

# AI: when true, non-empty main search calls POST /api/listings/ai-search (backend may still use mock without GEMINI_API_KEY).
VITE_AI_CONVERSATIONAL_SEARCH=false

# Optional: API origin if you are not using Vite /api proxy (default empty = same-origin relative /api/...).
# VITE_API_BASE_URL=http://127.0.0.1:3000
